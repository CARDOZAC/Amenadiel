# ==========================================
# SUPABASE CONFIGURATION
# ==========================================
# Instrucciones:
# 1. Copia este archivo y renómbralo a: .env.local
# 2. Ve a tu proyecto de Supabase: Settings > API
# 3. Reemplaza los valores de abajo con tus credenciales reales
# 4. NUNCA compartas .env.local ni lo subas a git

# 🔗 Project URL (de Settings > API > Project URL)
# Ejemplo: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# 🔑 Anon Key (de Settings > API > anon/public)
# Esta key es segura para usar en el frontend (tiene restricciones RLS)
# Ejemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# 🔐 Service Role Key (de Settings > API > service_role/secret)
# ⚠️ NUNCA expongas esta clave en el frontend
# ⚠️ Solo usar en server-side code (Server Actions, API Routes)
# Ejemplo: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# 📦 Storage URL (construida a partir del Project URL)
# Formato: https://[PROJECT_REF].supabase.co/storage/v1
# Ejemplo: https://abcdefghijklmnop.supabase.co/storage/v1
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://TU_PROJECT_REF.supabase.co/storage/v1

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# - TU_PROJECT_REF es la parte antes de .supabase.co en tu Project URL
# - Después de crear .env.local, reinicia el servidor: npm run dev
# - Si cambias estas variables, siempre reinicia el servidor
# - Verifica que .env.local esté en .gitignore
