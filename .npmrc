# Seguridad: Bloquear scripts de instalación por defecto
# Protección contra ataques de supply chain via postinstall malicioso
ignore-scripts=true

# Usar lockfile estricto en instalaciones
# Previene cambios no autorizados en el árbol de dependencias
strict-peer-dependencies=false
auto-install-peers=true

# Configuración de pnpm
shamefully-hoist=false
